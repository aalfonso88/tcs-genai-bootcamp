   "id": "9ece3445",
   "metadata": {},
   "outputs": [],
   "source": [
    "mensaje = \"\"\"Que me sugieres hacer en un dia frio?\"\"\"\n",
    "llm = \"llama3.2\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "75a146a2",
   "metadata": {},
   "outputs": [],
   "source": [
    "response = ollama.chat(model=llm, messages=[\n",
    "    {\n",
    "        'role': 'user',\n",
    "        'content': mensaje\n",
    "    }\n",
    "])"
   ]
  },
